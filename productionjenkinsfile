pipeline {
    agent any

 environment{
        dockerhub_cred = credentials('docker-cred')
    }
    stages {

        stage('Clone Code') {
            steps {
                git branch: 'main', url: 'https://github.com/parimallpradhan/ecommerce-app.git'
            }
        }

        stage('Build WAR') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh "docker build -t parimal/eommerceproject:${BUILD_NUMBER} ."
                sh "docker tag parimal/eommerceproject:${BUILD_NUMBER} parimal1984/eommerceproject:${BUILD_NUMBER}"
                
            }
        }
        stage('dockerhub login'){
            steps{
                sh "echo $dockerhub_cred_PSW | docker login -u $dockerhub_cred_USR --password-stdin"
              
            }
        }
       stage('dockerhub push'){
            steps{
                
               sh "docker push parimal1984/eommerceproject:${BUILD_NUMBER}"
            }
        }
    // 🚧 DEV Deployment
        stage('Deploy to DEV') {
            steps {
                sh '''
                docker rm -f ecommerce-dev || true
                docker run -d -p 8081:8080 --name ecommerce-dev parimal1984/eommerceproject:${BUILD_NUMBER}
                '''
            }
        }

        // 🧪 QA Deployment
        stage('Deploy to QA') {
            steps {
                sh '''
                docker rm -f ecommerce-qa || true
                docker run -d -p 8082:8080 --name ecommerce-qa parimal1984/eommerceproject:${BUILD_NUMBER}
                '''
            }
        }

        // ⛔ Manual Approval before PROD
        stage('Approval for PROD') {
            steps {
                input message: "Deploy to Production?", ok: "Deploy"
            }
        }

        // 🚀 PROD Deployment
        stage('Deploy to PROD') {
            steps {
                sh '''
                docker rm -f ecommerce-prod || true
                docker run -d -p 8083:8080 --name ecommerce-prod parimal1984/eommerceproject:${BUILD_NUMBER}
                '''
            }
        }
   // stage('Docker run'){
     //       steps{
       //         sh 'docker rm -f ecommerce-aoo || true'
         //       sh "docker run -d -p 80:8080 --name ecommerce-aoo parimal1984/eommerceproject:${BUILD_NUMBER}"
                
           // }
       // }
    }
    post {
        always {
            echo "job is completed"
        }
        success {
            echo "It is a success"
        }
        failure {
            echo "It has failed"
         }
    }
}
